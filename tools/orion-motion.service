# Motion Core no Raspberry Pi (Fase 7): servidor TCP para o Notebook,
# ponte serial com o Arduino, navegacao, banco no SSD e interface web -
# python -m motion_core como servico de usuario do systemd.
#
# Instalacao (no Pi):
#   cp tools/orion-motion.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now orion-motion.service
#   loginctl enable-linger jproma23   # sobe no boot mesmo sem login
[Unit]
Description=Fofão - Motion Core (TCP + serial + navegação + banco + web)
After=network.target

[Service]
WorkingDirectory=%h/orion-os
# Segredos que NAO podem viver no repositorio (ele e publico no GitHub):
# hoje so ORION_SENHA_CONFIG, a senha da pagina CONFIGURACAO. O "-" faz o
# arquivo ser opcional - sem ele o servico sobe igual, apenas com o acesso
# por senha desligado e a pagina restrita ao proprio Raspberry.
EnvironmentFile=-%h/orion-os/config/secrets.env
ExecStart=%h/orion-os/.venv/bin/python -u -m motion_core
Restart=always
RestartSec=5

# LOG EM ARQUIVO, e nao so no journal (achado real, 2026-07-27): o
# systemd-journald do USUARIO esta inativo neste Pi, entao
# `journalctl --user -u orion-motion.service` responde "No journal files were
# found" e TUDO que o Motion Core imprime se perde. Ficamos sem saber por que
# algo falhou - inaceitavel para as 72h de operacao continua que o projeto
# persegue, em que a falha acontece de madrugada e ninguem esta olhando.
#
# `append:` (e nao `file:`) preserva o log entre reinicios do servico, que e
# justamente quando ele mais importa: com Restart=always, um crash em laco
# apagaria a propria evidencia a cada 5s.
#
# O diretorio precisa existir antes; o ExecStartPre garante isso numa
# instalacao nova, sem exigir passo manual.
ExecStartPre=/bin/mkdir -p %h/orion-os/data/logs
StandardOutput=append:%h/orion-os/data/logs/motion_core.log
StandardError=append:%h/orion-os/data/logs/motion_core.log

[Install]
WantedBy=default.target
