  <version>0.1.0</version>
  <description>Ponte ORION &lt;-&gt; Nav2: publica /scan e /odom a partir do Motion Core e traduz /cmd_vel em comandos do robo.</description>
  <maintainer email="jproma23@localhost">jproma23</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>slam_toolbox</depend>

  <exec_depend>nav2_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
